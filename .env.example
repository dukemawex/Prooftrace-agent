# All three stages use fixed NVIDIA Nemotron model IDs.
METERLESS_BASE_URL=https://api.meterless.io/v1
# Direct NVIDIA NIM is also supported: https://integrate.api.nvidia.com/v1
METERLESS_API_KEY=
# Optional fallback (also works without a Meterless key). Routes the 3 stages across free
# NVIDIA Nemotron models via https://openrouter.ai/api/v1 with auto-cascade (see backend/config.py).
OPENROUTER_API_KEY=
MODEL_TIMEOUT_SECONDS=90

# Full Zetaris OpenSqlQuery execution endpoint from your instance's API collection.
# Request: {"select": "SELECT ...", "pageLimit": 100}; bearer token in ZETARIS_API_KEY.
# A SQL gateway can instead use ZETARIS_QUERY_FIELD=query or sql.
ZETARIS_API_URL=
ZETARIS_API_KEY=
ZETARIS_QUERY_FIELD=select
ZETARIS_TIMEOUT_SECONDS=15
# true allows the seeded database when Zetaris is unavailable; surfaced in every trace.
# render.yaml sets false: without Zetaris credentials live investigations then fail. Set true for a DB-only demo.
ALLOW_LOCAL_FALLBACK=true
# Logical table/view names exposed by your Zetaris catalog (optional schema prefix).
ZETARIS_AML_TABLE=aml_transactions
ZETARIS_KYC_TABLE=icij_kyc_entities
ZETARIS_SANCTIONS_TABLE=opensanctions_watchlist

# Local default: SQLite. Set DATABASE_URL for the Postgres fallback and state store.
SQLITE_PATH=data/prooftrace.db
DATABASE_URL=
# Optional separate KYC silo, mirrored to SQL for deterministic fallback.
MONGODB_URI=
MONGODB_DATABASE=prooftrace
SEED_ROW_COUNT=300
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional shared backend access key; only send from trusted clients or the Next proxy.
PROOFTRACE_API_KEY=

# Next.js server-side proxy settings. Secrets never use NEXT_PUBLIC_ variables.
BACKEND_URL=http://127.0.0.1:8000
